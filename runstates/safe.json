    { "id": "stop-games", "label": "Stop game launchers", "action": "process.stop",
      "params": { "names": ["steam.exe", "steamwebhelper.exe", "gameoverlayui.exe"], "grace_s": 10 },
      "est_s": 8, "weight": 0.6, "critical": false },
    { "id": "stop-browsers", "label": "Stop Chrome", "action": "process.stop",
      "params": { "names": ["chrome.exe"], "grace_s": 10 }, "est_s": 8, "weight": 0.6, "critical": false },
    { "id": "stop-music", "label": "Stop TIDAL", "action": "process.stop",
      "params": { "names": ["tidal.exe"], "grace_s": 6 }, "est_s": 5, "weight": 0.4, "critical": false },
    { "id": "power", "label": "Power saver plan", "action": "power.plan",
